{#
 # JAMF Sync — monitoring page (sync run history).
 # Rendered by GlpiPlugin\Jamfsync\Ui\MonitoringPage::display(), inside ConfigMenu::open()/close().
 # run.changes_html is the output of GLPI's own Search::showList() and is the only |raw value.
 #}
<div class="card mb-3">
    <div class="card-header"><h3 class="card-title mb-0">{{ __('Filter', 'jamfsync') }}</h3></div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label" for="jamfsync-instance">{{ __('Instance', 'jamfsync') }}</label>
                <select class="form-select" id="jamfsync-instance" name="instance_id">
                    <option value="0">{{ __('All') }}</option>
                    {% for instance in instances %}
                        <option value="{{ instance.id }}" {{ filters.instance_id == instance.id ? 'selected' : '' }}>{{ instance.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label" for="jamfsync-entity">{{ __('Entity ID', 'jamfsync') }}</label>
                <input class="form-control" id="jamfsync-entity" name="entity_id" type="number" min="0" value="{{ filters.entity_id }}">
            </div>
            <div class="col-md-2">
                <label class="form-label" for="jamfsync-status">{{ __('Status') }}</label>
                <select class="form-select" id="jamfsync-status" name="status">
                    <option value="">{{ __('All') }}</option>
                    <option value="success" {{ filters.status == 'success' ? 'selected' : '' }}>{{ __('Success', 'jamfsync') }}</option>
                    <option value="error" {{ filters.status == 'error' ? 'selected' : '' }}>{{ __('Error', 'jamfsync') }}</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="jamfsync-from">{{ __('From', 'jamfsync') }}</label>
                <input class="form-control" id="jamfsync-from" name="date_from" type="date" value="{{ filters.date_from }}">
            </div>
            <div class="col-md-2">
                <label class="form-label" for="jamfsync-to">{{ __('To', 'jamfsync') }}</label>
                <input class="form-control" id="jamfsync-to" name="date_to" type="date" value="{{ filters.date_to }}">
            </div>
            <div class="col-md-2">
                <label class="form-label" for="jamfsync-limit">{{ __('Limit', 'jamfsync') }}</label>
                <input class="form-control" id="jamfsync-limit" name="limit" type="number" min="20" max="500" value="{{ filters.limit }}">
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">{{ __('Apply', 'jamfsync') }}</button>
                <a class="btn btn-outline-secondary" href="{{ reset_url }}">{{ __('Reset') }}</a>
                <a class="btn btn-outline-success ms-auto" href="{{ export_url }}">
                    <i class="ti ti-file-spreadsheet me-1"></i>{{ __('Export CSV', 'jamfsync') }}
                </a>
            </div>
        </form>
    </div>
</div>

{% if run %}
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title mb-0">{{ __('Run details', 'jamfsync') }} #{{ run.id }}</h3>
            <a class="btn btn-sm btn-outline-secondary ms-auto" href="{{ close_url }}">{{ __('Close details', 'jamfsync') }}</a>
        </div>
        <div class="card-body">
            <div class="row g-3">
                {% for label, value in run.fields %}
                    <div class="col-md-4">
                        <div class="text-muted small">{{ label }}</div>
                        <div>{{ value }}</div>
                    </div>
                {% endfor %}
                <div class="col-12">
                    <div class="text-muted small">{{ __('Message', 'jamfsync') }}</div>
                    <pre class="bg-light border rounded p-2 mb-0" style="white-space: pre-wrap;">{{ run.message }}</pre>
                </div>

                {% if run.changes_html is not null %}
                    <div class="col-12">
                        <button class="btn btn-outline-secondary btn-sm mb-2" type="button"
                                data-bs-toggle="collapse" data-bs-target="#jamfsync-run-changes"
                                aria-expanded="{{ run.show_changes ? 'true' : 'false' }}" aria-controls="jamfsync-run-changes">
                            {{ __('Changed items', 'jamfsync') }} ({{ run.changed_count }})
                        </button>
                        <div id="jamfsync-run-changes" class="collapse{{ run.show_changes ? ' show' : '' }}">
                            <ul class="nav nav-tabs mb-2">
                                {% for tab in run.tabs %}
                                    <li class="nav-item">
                                        <a class="nav-link{{ tab.active ? ' active' : '' }}" href="{{ tab.url }}">{{ tab.label }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                            {# Before/after JSON columns are wide; scroll inside the card. #}
                            <div class="table-responsive">{{ run.changes_html|raw }}</div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}

<div class="row g-3 mb-3">
    {% for label, value in {
        (__('Runs', 'jamfsync')): summary.runs,
        (__('Success', 'jamfsync')): summary.success,
        (__('Error', 'jamfsync')): summary.error,
        (__('Devices', 'jamfsync')): summary.devices,
        (__('Apps', 'jamfsync')): summary.apps,
        (__('Processed', 'jamfsync')): summary.processed,
        (__('Changed', 'jamfsync')): summary.changed,
    } %}
        <div class="col-md-3 col-lg-2">
            <div class="card h-100">
                <div class="card-body py-3">
                    <div class="text-muted small">{{ label }}</div>
                    <div class="fs-3 fw-bold">{{ value }}</div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{% if missing is not empty %}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title mb-0">
                <i class="ti ti-device-tablet-off me-1"></i>{{ __('Devices no longer returned by JAMF', 'jamfsync') }}
            </h3>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-3">{{ __('Mapped devices that the last successful run of their instance did not receive from JAMF (retired, deleted or moved to another JAMF instance). GLPI keeps the computers; nothing is deleted automatically.', 'jamfsync') }}</p>
            {% for group in missing %}
                <h4 class="mb-2">{{ group.instance }}
                    <span class="badge bg-warning-lt ms-1">{{ group.total }}</span>
                    <span class="text-muted small fw-normal ms-2">{{ __('Last successful run', 'jamfsync') }}: {{ group.last_run }}</span>
                </h4>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr>
                                <th>{{ __('Computer', 'jamfsync') }}</th>
                                <th>{{ __('Serial number') }}</th>
                                <th>{{ __('Device ID', 'jamfsync') }}</th>
                                <th>{{ __('Last seen in JAMF', 'jamfsync') }}</th>
                                <th>{{ __('Last check-in', 'jamfsync') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for row in group.rows %}
                                <tr>
                                    <td>
                                        {% if row.computer_url %}
                                            <a href="{{ row.computer_url }}">{{ row.computer_name ?: ('#' ~ row.computers_id) }}</a>
                                            {% if row.computer_is_deleted %}<span class="badge bg-secondary-lt ms-1">{{ __('Deleted') }}</span>{% endif %}
                                        {% else %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ row.jamf_serial }}</td>
                                    <td>{{ row.jamf_device_id }}</td>
                                    <td>{{ row.last_seen_at }}</td>
                                    <td>{{ row.last_checkin_at }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if group.total > group.rows|length %}
                    <p class="text-muted small">{{ __('Showing the first %d entries.', 'jamfsync')|format(group.rows|length) }}</p>
                {% endif %}
            {% endfor %}
        </div>
    </div>
{% endif %}

<div class="card">
    <div class="card-header d-flex align-items-center flex-wrap gap-2">
        <h3 class="card-title mb-0">{{ __('Recent sync runs', 'jamfsync') }}</h3>
        {% set keep_runs = retention.retention_syncruns_days > 0 ? __('%d days', 'jamfsync')|format(retention.retention_syncruns_days) : __('forever', 'jamfsync') %}
        {% set keep_changes = retention.retention_runchanges_days > 0 ? __('%d days', 'jamfsync')|format(retention.retention_runchanges_days) : __('forever', 'jamfsync') %}
        <span class="text-muted small ms-auto">
            <i class="ti ti-clock-shield me-1"></i>{{ __('Kept: runs %1$s, change details %2$s', 'jamfsync')|format(keep_runs, keep_changes) }}
            {% if retention_url %}
                · <a href="{{ retention_url }}">{{ _x('setup', 'Data and Privacy') }}</a>
            {% endif %}
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>{{ __('Started', 'jamfsync') }}</th>
                    <th>{{ __('Instance', 'jamfsync') }}</th>
                    <th>{{ __('Entity') }}</th>
                    <th>{{ __('Status') }}</th>
                    <th>{{ __('Mode', 'jamfsync') }}</th>
                    <th>{{ __('Devices', 'jamfsync') }}</th>
                    <th>{{ __('Apps', 'jamfsync') }}</th>
                    <th>{{ __('Processed', 'jamfsync') }}</th>
                    <th>{{ __('Changed', 'jamfsync') }}</th>
                    <th>{{ __('Cursor', 'jamfsync') }}</th>
                    <th>{{ __('Message', 'jamfsync') }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.id }}</td>
                        <td>{{ row.started_at }}</td>
                        <td>{{ row.instance_name }}</td>
                        <td>{{ row.entities_id }}</td>
                        <td><span class="badge bg-{{ row.status == 'success' ? 'success' : 'danger' }}">{{ row.status_label }}</span></td>
                        <td>{{ row.mode_label }}</td>
                        <td>{{ row.devices_count }}</td>
                        <td>{{ row.apps_count }}</td>
                        <td>{{ row.processed_count }}</td>
                        <td>{{ row.changed_count }}</td>
                        <td><code>{{ row.cursor_start }} -&gt; {{ row.cursor_end }}</code></td>
                        <td>{{ row.message }}</td>
                        <td><a class="btn btn-sm btn-outline-secondary" href="{{ row.detail_url }}">{{ __('View', 'jamfsync') }}</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="13" class="text-muted">{{ __('No sync runs found for current filter.', 'jamfsync') }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
